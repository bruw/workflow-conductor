{
  "version": 1,
  "name": "demo",
  "nextId": 30,
  "nodes": [
    {
      "id": "n27",
      "type": "start",
      "name": "start",
      "knobs": {
        "goal": "Answer a question from many sources: search several ways, read deeply, check for gaps, then write up"
      }
    },
    {
      "id": "n28",
      "type": "phase",
      "name": "design",
      "children": [
        {
          "id": "n4",
          "type": "pipeline",
          "name": "deep read",
          "logic": "Each source is read and checked independently.",
          "knobs": {
            "oncePer": "deduped sources"
          },
          "children": [
            {
              "id": "n2",
              "type": "agent",
              "name": "searchs",
              "logic": "One agent per search angle",
              "knobs": {
                "prompt": "Search for sources on the question using only this angle",
                "output": "{ sources: [{ ref, why }] }",
                "model": "opus",
                "effort": "low"
              }
            },
            {
              "id": "n6",
              "type": "agent",
              "name": "check claims",
              "logic": "Drop claims the source does not actually support.",
              "knobs": {
                "prompt": "Try to refute each claim against the quoted source",
                "model": "sonnet",
                "effort": "low"
              }
            },
            {
              "id": "n1",
              "type": "parallel",
              "kind": "sweep",
              "name": "multi-modal sweep",
              "logic": "Each searcher is blind to the others, so expect overlap between their results.",
              "knobs": {
                "oncePer": "4 search angles: by container, by content, by entity, by time"
              },
              "children": [
                {
                  "id": "n29",
                  "type": "agent",
                  "name": "agent"
                }
              ]
            },
            {
              "id": "n5",
              "type": "agent",
              "name": "read source",
              "logic": "One reader per source.",
              "knobs": {
                "prompt": "Read the source in full and extract the claims that bear on the question, with quotes",
                "output": "{ claims: [{ claim, quote, confidence }] }"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "n17",
      "type": "branch",
      "name": "branch",
      "children": [
        {
          "id": "n21",
          "type": "loop",
          "kind": "count",
          "name": "count",
          "children": [
            {
              "id": "n22",
              "type": "agent",
              "name": "agent"
            }
          ]
        }
      ]
    },
    {
      "id": "n20",
      "type": "agent",
      "name": "agent"
    },
    {
      "id": "n23",
      "type": "agent",
      "kind": "verify",
      "name": "verify",
      "knobs": {
        "effort": "high"
      }
    },
    {
      "id": "n24",
      "type": "agent",
      "kind": "critic",
      "name": "critic",
      "knobs": {
        "model": "sonnet",
        "effort": "high"
      }
    }
  ]
}
